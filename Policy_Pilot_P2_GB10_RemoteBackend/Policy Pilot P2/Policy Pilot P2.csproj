<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fb180b92-d41d-4631-96f3-2e027bf5139d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OllamaSharp" Version="5.4.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.6.0-preview.1.26261.4" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Markdig" Version="10.6.0-preview.1.26261.4" />
    <PackageReference Include="PdfPig" Version="0.1.12" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="1.0.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="1.0.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.SqliteVec" Version="1.67.1-preview" />
    <PackageReference Include="TTUHSC.PAWS.Authentication.SSO" Version="1.0.2" />
    <PackageReference Include="TTUHSC.PAWS.Template" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backend Python files are kept in source for GB10 deployment, but they are not published with the Blazor web app. -->
    <Content Remove="App_Data\GB10_Chroma\**\*" />
    <None Include="App_Data\GB10_Chroma\**\*" Exclude="App_Data\GB10_Chroma\**\__pycache__\**;App_Data\GB10_Chroma\**\*.pyc" />
  </ItemGroup>

</Project>