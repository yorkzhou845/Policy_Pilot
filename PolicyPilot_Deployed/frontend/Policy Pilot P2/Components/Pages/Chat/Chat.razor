@page "/"
@attribute [Authorize]
@inject NavigationManager Nav
@inject Gb10ChromaBackendService Backend
@inject IJSRuntime JS
@inject ILogger<Chat> Logger
@implements IDisposable

<PageTitle>Chat</PageTitle>

<ChatHeader OnNewChat="@ResetConversationAsync" />

<ChatMessageList Messages="@messages" InProgressMessage="@currentResponseMessage">
    <NoMessagesContent>
        <div>
            I am still very new and still learning, but I am happy to take any question regarding Operation Policies!
        </div>

        <div style="margin-top: 0.75rem; font-size: 0.95rem; color: #666;">
            Policy Pilot provides AI-assisted policy summaries. It is not the official policy source.
            Always verify answers against the cited TTUHSC policy documents.
        </div>

        <a href="/documents"
           target="_blank"
           rel="noopener noreferrer"
           style="color: blue; text-decoration: underline;">
            View policy document folder
        </a>
    </NoMessagesContent>
</ChatMessageList>

<div class="chat-container">
    <div class="runtime-context-panel">
        <label for="user-campus" class="runtime-context-label">Campus / location</label>
        <select id="user-campus" class="runtime-context-select" @bind="selectedLocation">
            <option value="Lubbock">Lubbock</option>
            <option value="Abilene">Abilene</option>
            <option value="Amarillo">Amarillo</option>
            <option value="Dallas (including Mansfield)">Dallas (including Mansfield)</option>
            <option value="Permian Basin">Permian Basin</option>
        </select>
        <span class="runtime-context-note">Current date/time and time zone are added automatically.</span>
    </div>

    <ChatInput OnSend="@AddUserMessageAsync" @ref="@chatInput" />
</div>

@code {
    private const int MaxPromptLength = 2000;
    private const int MaxRequestsPerMinute = 10;

    private const string SystemPrompt = @"
You are a policy assistant for Texas Tech University Health Sciences Center operating policies.
Your campus/location context comes from the user's campus selector.
The only supported campus/location selections are: Lubbock, Abilene, Amarillo, Dallas (including Mansfield), and Permian Basin.

For policy questions, answer using only retrieved policy excerpts from the Search tool.
Do not use outside knowledge.
Do not guess.
Do not make up rules, procedures, deadlines, exceptions, or contact information.

Runtime context includes the user's current date, local time, time zone, and selected campus/location.
If the user asks only for the current date, current time, today's date, selected campus/location, or where you are based, answer directly from runtime context and do not use policy citations.
Use runtime context for policy answers only to interpret relative wording such as ""today,"" ""tomorrow,"" ""this year,"" ""current,"" ""near me,"" or ""my campus.""
Runtime context is not policy content.
Do not use runtime context to invent policy rules, procedures, deadlines, exceptions, offices, or contact information.

Every paragraph or bullet point that contains policy information must include a source filename in parentheses, like this: (Source: op0101.pdf).

If the retrieved content does not clearly support the policy answer, say: ""I do not know based on the provided policy content.""

At the end of every answer based on retrieved content, include XML citation tags using this exact format:
<citation filename='actual_filename.pdf'>exact short quote</citation>

Only include XML citation tags for sources actually used in the answer.
If no sources are used, write Sources used: None and do not include XML citation tags.
Do not omit source filenames when policy sources are used.
";

    private readonly List<ChatMessage> messages = new();
    private readonly Queue<DateTimeOffset> recentRequests = new();

    private CancellationTokenSource? currentResponseCancellation;
    private ChatMessage? currentResponseMessage;
    private ChatInput? chatInput;
    private string selectedLocation = "Lubbock";

    protected override void OnInitialized()
    {
        messages.Add(new(ChatRole.System, SystemPrompt));
    }

    private async Task<UserRuntimeContext> GetRuntimeContextAsync()
    {
        UserRuntimeContext context;

        try
        {
            context = await JS.InvokeAsync<UserRuntimeContext>("userRuntimeContext.get");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read browser runtime context. Falling back to server-local context.");

            context = new UserRuntimeContext
            {
                CurrentDateTimeLocal = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                CurrentDateIsoUtc = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                TimeZone = TimeZoneInfo.Local.Id,
                Location = selectedLocation
            };
        }

        context.Location = selectedLocation;
        return context;
    }

    private async Task AddUserMessageAsync(ChatMessage userMessage)
    {
        CancelAnyCurrentResponse();

        messages.Add(userMessage);

        var responseText = new TextContent("");
        var assistantMessage = new ChatMessage(ChatRole.Assistant, [responseText]);
        var responseCancellation = new CancellationTokenSource();

        currentResponseMessage = assistantMessage;
        currentResponseCancellation = responseCancellation;

        await InvokeAsync(StateHasChanged);

        try
        {
            await TryFocusChatInputAsync();

            var userText = userMessage.Text ?? string.Empty;

            if (string.IsNullOrWhiteSpace(userText))
            {
                responseText.Text = "Please enter a question.";
                ChatMessageItem.NotifyChanged(assistantMessage);
            }
            else if (userText.Length > MaxPromptLength)
            {
                responseText.Text = $"Your question is too long. Please shorten it to {MaxPromptLength} characters or fewer and try again.";
                ChatMessageItem.NotifyChanged(assistantMessage);
            }
            else if (!TryRecordRequest(out var rateLimitMessage))
            {
                responseText.Text = rateLimitMessage;
                ChatMessageItem.NotifyChanged(assistantMessage);
            }
            else
            {
                var runtimeContext = await GetRuntimeContextAsync();

                responseText.Text = await Backend.GetAnswerAsync(
                    userText,
                    runtimeContext,
                    responseCancellation.Token);

                ChatMessageItem.NotifyChanged(assistantMessage);
            }
        }
        catch (OperationCanceledException) when (responseCancellation.IsCancellationRequested)
        {
            responseText.Text = "Response cancelled.";
            ChatMessageItem.NotifyChanged(assistantMessage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while generating chat response.");

            responseText.Text = @"""
            An error occurred while generating the response.

            Please try again. If the issue continues, contact the system administrator.
            """;

            ChatMessageItem.NotifyChanged(assistantMessage);
        }
        finally
        {
            if (currentResponseMessage == assistantMessage)
            {
                messages.Add(assistantMessage);
                currentResponseMessage = null;
            }

            if (currentResponseCancellation == responseCancellation)
            {
                currentResponseCancellation = null;
            }

            responseCancellation.Dispose();

            await InvokeAsync(StateHasChanged);
        }
    }

    private bool TryRecordRequest(out string message)
    {
        var now = DateTimeOffset.UtcNow;

        while (recentRequests.Count > 0 && now - recentRequests.Peek() > TimeSpan.FromMinutes(1))
        {
            recentRequests.Dequeue();
        }

        if (recentRequests.Count >= MaxRequestsPerMinute)
        {
            message = "Too many requests. Please wait a minute and try again.";
            return false;
        }

        recentRequests.Enqueue(now);
        message = string.Empty;
        return true;
    }

    private async Task TryFocusChatInputAsync()
    {
        if (chatInput is null)
        {
            return;
        }

        try
        {
            await chatInput.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not focus chat input.");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Could not focus chat input because the component was not ready.");
        }
    }

    private void CancelAnyCurrentResponse()
    {
        if (currentResponseMessage is not null)
        {
            messages.Add(currentResponseMessage);
        }

        currentResponseCancellation?.Cancel();
        currentResponseMessage = null;
    }

    private async Task ResetConversationAsync()
    {
        CancelAnyCurrentResponse();

        messages.Clear();
        messages.Add(new(ChatRole.System, SystemPrompt));

        await TryFocusChatInputAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        currentResponseCancellation?.Cancel();
        currentResponseCancellation?.Dispose();
    }
}