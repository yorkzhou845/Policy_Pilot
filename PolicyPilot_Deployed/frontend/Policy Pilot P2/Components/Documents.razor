@*This is to create a new link that is like a folder and will show al the links*@

@page "/documents"
@attribute [Authorize]

@using System.IO
@inject IWebHostEnvironment Env

<PageTitle>Policy Documents</PageTitle>

<h1>TTUHSC Policy Documents</h1>

<p>Select a file to open it in a new tab.</p>

@if (!DataFiles.Any())
{
    <p>No policy files found.</p>
}
else
{
    <ul>
        @foreach (var file in DataFiles)
        {
            <li>
                <a href="@($"/Data/{Uri.EscapeDataString(file)}")" target="_blank" rel="noopener noreferrer">
                    @file
                </a>
            </li>
        }
    </ul>
}

@code {
    private IEnumerable<string> DataFiles
    {
        get
        {
            var dataPath = Path.Combine(Env.WebRootPath, "Data");

            if (!Directory.Exists(dataPath))
            {
                return Enumerable.Empty<string>();
            }

            return Directory.EnumerateFiles(dataPath)
                .Select(Path.GetFileName)
                .OfType<string>()
                .Where(file =>
                    file.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ||
                    file.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
                .OrderBy(file => file);
        }
    }
}
