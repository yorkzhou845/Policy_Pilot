@inherits LayoutComponentBase

@if (!string.IsNullOrWhiteSpace(_headerHtml))
{
    <div class="paws-template-fragment paws-template-header">
        @((MarkupString)_headerHtml)
    </div>
}


<AuthorizeView>
    <Authorized Context="authState">
        <div class="account-bar">
            <span>Signed in as <strong>@(authState.User.Identity?.Name ?? "authenticated user")</strong></span>
            <form method="post" action="/Account/Logout" style="display: inline; margin-left: 1rem;">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link p-0 align-baseline">Sign out</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="account-bar">
            <a href="/Account/Login">Sign in</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

<main role="main" class="policy-pilot-main">
    @Body
</main>

@if (!string.IsNullOrWhiteSpace(_footerHtml))
{
    <div class="paws-template-fragment paws-template-footer">
        @((MarkupString)_footerHtml)
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string HeaderUrl = "https://scd.ttuhsc.edu/templates/hsc/1.1/header.xhtml";
    private const string FooterUrl = "https://scd.ttuhsc.edu/templates/hsc/1.1/footer.xhtml";

    private static readonly System.Net.Http.HttpClient Http = new();

    private string? _headerHtml;
    private string? _footerHtml;

    protected override async Task OnInitializedAsync()
    {
        _headerHtml = await TryGetTemplateFragmentAsync(HeaderUrl);
        _footerHtml = await TryGetTemplateFragmentAsync(FooterUrl);
    }

    private static async Task<string?> TryGetTemplateFragmentAsync(string url)
    {
        try
        {
            return await Http.GetStringAsync(url);
        }
        catch
        {
            return null;
        }
    }
}