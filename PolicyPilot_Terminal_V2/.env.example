# Local Ollama API. No API key is required for a default local Ollama installation.
OLLAMA_BASE_URL=http://localhost:11434

# Replace these with models installed in your local Ollama instance.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=embeddinggemma

# Optional. Leave blank to disable the extra guard-model pass.
OLLAMA_GUARD_MODEL=

# Relative paths are resolved from the project directory.
DOCUMENTS_DIR=data/documents
VECTOR_DB_CSV=data/vector_store/vectors.csv

# Retrieval and chunking settings.
TOP_K=5
MAX_CHUNK_CHARS=4000
CHUNK_OVERLAP_CHARS=400
MAX_CONTEXT_CHARS=16000
OLLAMA_CONTEXT_WINDOW=8192
EMBED_BATCH_SIZE=16
OLLAMA_TIMEOUT_SECONDS=180
