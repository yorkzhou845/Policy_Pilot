@inherits LayoutComponentBase

<div class="site-shell">
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" href="/">Policy Pilot Local</a>
            <span class="tagline">Local document-grounded Q&amp;A</span>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <span>Local portfolio template. Verify answers against the underlying documents.</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss">×</button>
</div>
